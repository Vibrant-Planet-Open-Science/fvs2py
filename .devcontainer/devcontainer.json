{
    "name": "fvs2py Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "${localEnv:USER}",
    "updateRemoteUserUID": true,
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}/fvs2py"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils": {
            "user": "${localEnv:USER}",
            "installNano": true,
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "configureZshAsDefaultShell": true
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "johnpapa.vscode-peacock",
                "ms-azuretools.vscode-docker",
                "ms-python.black-formatter",
                "ms-python.isort",
                "ms-python.mypy-type-checker",
                "ms-python.python",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.jupyter",
                "vscode-icons-team.vscode-icons"
            ],
            "settings": {
                "mypy-type-checker.args": [
                    "--config-file",
                    "mypy.ini"
                ],
                "notebook.formatOnSave.enabled": true,
                "python.analysis.extraPaths": [
                    "${containerWorkspaceFolder}/fvs2py"
                ],
                "python.linting.mypyEnabled": true,
                "python.linting.enabled": true,
                "[python]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll": "explicit",
                        "source.organizeImports": "explicit"
                    },
                    "terminal.integrated.env.linux": {
                        "PYTHONPATH": "${containerWorkspaceFolder}/fvs2py"
                    }
                }
            }
        }
    },
    "runArgs": [
        "--name",
        "fvs2py-dev"
    ],
    "postCreateCommand": "pip freeze > /tmp/constraints.txt && pip install -c /tmp/constraints.txt -r requirements-dev.txt && pre-commit install",
    "postStartCommand": "git config --global core.trustctime false && git config --global core.checkStat minimal"
}